    },
    "./semantic": {
      "types": "./src/semantic.ts",
      "import": "./src/semantic.ts"
    },
    "./recovery-archive": {
      "types": "./src/recovery-archive.ts",
      "import": "./src/recovery-archive.ts"
    },
    "./recovery-repository": {
      "types": "./src/recovery-repository.ts",
      "import": "./src/recovery-repository.ts"
