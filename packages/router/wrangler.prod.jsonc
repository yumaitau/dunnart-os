{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dunnart-os",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "services": [
    {
      "binding": "WORKSHOP_BACKEND",
      "service": "dunnart-os-workshop"
    },
    {
      "binding": "GATEKEEPER_CONTEXT",
      "service": "dunnart-os-context"
    },
    {
      "binding": "GATEKEEPER_SCHEDULER",
      "service": "dunnart-os-scheduler"
    }
  ],
  "assets": {
    "directory": "../workshop-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/blueprint-screenshot",
      "/blueprint-screenshot/*",
      "/gatekeeper/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "account_id": "3eed46cc48f123cdff00d116df5e5070",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dunnart.yumait.au",
      "custom_domain": true
    }
  ]
}
